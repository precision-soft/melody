MELODY_DEFAULT_MODE=http
MELODY_ENV=dev
MELODY_HTTP_ADDRESS=:8080
MELODY_CLI_NAME=melody-example
MELODY_CLI_DESCRIPTION='melody example application'
MELODY_LOG_PATH=%kernel.logs_dir%/%kernel.environment%.log
MELODY_LOG_LEVEL=debug
MELODY_DEFAULT_LOCALE=en
MELODY_PUBLIC_DIR=public
MELODY_STATIC_INDEX_FILE=index.html
MELODY_STATIC_ENABLE_CACHE=false
MELODY_STATIC_CACHE_MAX_AGE=0

APP_MAX_ITEMS_PER_PAGE=25
APP_CATALOG_TITLE=Melody Example Catalog

APP_CRON_USER=www-data
APP_CRON_HEARTBEAT_AUTO_ENABLED=true
APP_CRON_PRODUCT_USER=catalog
APP_API_TOKEN=example-api-token

# live-integration endpoints (database and cache). These default to the docker-compose service names so
# the integrations run live in development.
#
# melody reads configuration ONLY from the .env files beside the application. A variable already set in
# the process or host environment — an `env:` entry in a Kubernetes manifest, an `export` in the shell —
# is IGNORED, and the boot writes a warning naming each key it ignored. Override a value by putting it in
# `.env.local` (git-ignored, loaded after this file and winning over it) or in `.env.<MELODY_ENV>`, not by
# setting it in the environment.
#
# An UNSET key skips the integration entirely: the application boots, falls back to what it can reach in
# the process, and nothing is dialled — which is what keeps `go test`, `all.sh --skip-live` and a machine
# with no containers working unchanged. Unsetting is done HERE: remove the line, comment it out, or blank
# it in `.env.local` — the parameters read `%env(default::MYSQL_HOST)%`, so an empty value is an absent one.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=melody_example
MYSQL_USER=melody
MYSQL_PASSWORD=melody

REDIS_ADDRESS=redis:6379
REDIS_USER=
REDIS_PASSWORD=
