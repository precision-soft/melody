# everything below is PRODUCED by `cd assets && npm ci && npm run build`, which is the one step a
# fresh clone needs before the application works in a browser. <root>/.assets is the single source of
# the icons and they live nowhere else in the tree; assets/sync-icons.mjs copies them here, and the
# container entrypoint runs the same script for each major at startup

# shared icons copied from <root>/.assets by assets/sync-icons.mjs
/public/favicon.ico
/public/assets/favicon.svg
/public/assets/logo.png
/public/assets/apple-touch-icon.png

# frontend bundle built from assets/app.ts by esbuild
/public/assets/app.js

/.example