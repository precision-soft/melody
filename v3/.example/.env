MELODY_DEFAULT_MODE=http
MELODY_ENV=dev
MELODY_HTTP_ADDRESS=:8080
MELODY_CLI_NAME=melody-example
MELODY_CLI_DESCRIPTION='melody example application'
# a value may reference a parameter, as the log path does below. a value that needs a literal percent
# instead of a reference must double it: a password written as pa%%ss%%word resolves to pa%ss%word.
MELODY_LOG_PATH=%kernel.logs_dir%/%kernel.environment%.log
MELODY_LOG_LEVEL=debug
MELODY_DEFAULT_LOCALE=en
MELODY_PUBLIC_DIR=public
MELODY_STATIC_INDEX_FILE=index.html
# the bundle's assets change only with a build, so a browser keeps them for an hour and revalidates them by
# ETag and Last-Modified after that; a developer who wants every save fetched afresh turns it off in
# .env.dev.local, which wins over this file.
MELODY_STATIC_ENABLE_CACHE=true
MELODY_STATIC_CACHE_MAX_AGE=3600
# the prefixes the application's own doors own: the file server answers ahead of routing, so a file dropped
# under public/ with one of these names would otherwise be served in place of the door.
MELODY_STATIC_EXCLUDED_PATHS=/storage,/outbox,/twofactor,/internal
# a signed-in session expires after a day without a request; the value is the lifetime this deployment
# wants for the admin interface, and the session storage drops what outlived it.
MELODY_HTTP_SESSION_TTL=24h
# the sessions are kept in this file, relative to the project, so a signed-in browser survives a restart of the
# process, which the development supervisor does on every saved change; an empty value keeps them in memory.
APP_SESSION_FILE=var/session/session.json
# the catalogue's writes are small json documents and the stored objects small documents, so a body past
# 64 KiB is refused with 413 before a door reads it.
MELODY_HTTP_MAX_REQUEST_BODY_BYTES=65536

APP_MAX_ITEMS_PER_PAGE=25
APP_CATALOG_TITLE=Melody Example Catalog

# showcase wirings, each with the same switch as the integrations below: an empty (or removed) value
# leaves that door unwired. The origins arm the cors listeners, which answer a preflight ahead of the
# security chain; the request budget arms the kernel.request rate limit listener, which charges every
# request of one client address — the refused ones included — against a shared hourly budget, ahead of
# authentication. The budget is deliberately far above what browsing the example produces.
APP_CORS_ALLOW_ORIGINS=https://catalog.example.test
APP_REQUEST_BUDGET_PER_HOUR=100000

# the proxies whose X-Forwarded-For both budgets believe, comma-separated: an address, a prefix, or a host
# name resolved once at boot. It is the load balancer and nothing wider — a whole private range trusts every
# container of the deployment, and any of them then names the key it is charged to. The compose balancer has
# no stable address, so it is named by its service name; a name that does not resolve in a process (the
# balancer not running beside a cli command) is skipped and reported, and an empty list believes no header
# at all, so every request is charged to its peer.
APP_TRUSTED_PROXY_LIST=load-balancer

# the credential the metrics scraper presents on /metrics as "Authorization: Bearer <token>"; the exposition names
# every route and its traffic, so with a token set it answers no one else. The development prometheus
# (.dev/docker/prometheus/prometheus.yml) carries the same value. An empty value leaves /metrics public.
APP_METRICS_TOKEN=melody-example-metrics-scrape-token-0001

# the two outbound endpoints, each gating its own client. RATES_BASE_URL is a BASE and carries its trailing
# slash: the client resolves every target against it by RFC 3986, so the slash is what keeps "/v1" a prefix
# instead of a segment the merge cuts, and a base written without it is refused at construction. The export
# endpoint is a whole url instead, because an operator may point it at any host — a client with a base
# refuses a target that leaves that origin, so the export holds no base and names the url outright.
# Blank either one and that door stays unwired: the refresh becomes a no-op and the report is not exported.
# The rates base is plain http only because it names the stack's own balancer, which answers a fixed document
# inside the compose network; a real provider is https, since whoever can rewrite its answer sets every price
# the catalogue converts.
RATES_BASE_URL=http://rates.melody.localhost.precision-soft.com/v1/
# the base every rate of the catalogue is quoted against. The refresh REFUSES a provider's document quoted
# against any other base, whole and before it writes a quote: a conversion cancels the base by dividing one
# rate by another, which is arithmetic only while every rate shares it. The seed quotes against the euro, so
# EUR is the value a catalogue that was never reseeded against another base carries; absent, it defaults to
# EUR — blank, it refuses every document.
RATES_BASE_CURRENCY=EUR
APP_REPORTING_EXPORT_ENDPOINT=http://rates.melody.localhost.precision-soft.com/v1/report-sink

APP_CRON_USER=www-data
APP_CRON_HEARTBEAT_AUTO_ENABLED=true
APP_CRON_PRODUCT_USER=catalog

APP_CRON_IMAGE=registry.example.com/melody-example:latest
APP_CRON_NAMESPACE=melody-example
APP_CRON_RESTART_POLICY=OnFailure

# live-integration endpoints (database/redis/amqp/s3/smtp).
# these default to the docker-compose service names so the integrations run live in dev. Defined in
# the project .env (not the docker container) so `go test` never inherits them and the
# env-gated integration tests skip cleanly instead of dialing services the validation
# run does not start.
#
# melody reads configuration ONLY from the .env files beside the application. A variable already set in
# the process or host environment — an `env:` entry in a Kubernetes manifest, an `export` in the shell —
# is IGNORED, and the boot writes a warning naming each key it ignored. Override a value by putting it in
# `.env.local` (git-ignored, loaded after this file and winning over it) or in `.env.<MELODY_ENV>`, not by
# setting it in the environment. Unsetting a key is done HERE too: remove the line, comment it out, or
# blank it in `.env.local` — the switches are read through `%env(default::MYSQL_HOST)%`, so empty is absent,
# and no parameter of the application assembles a template out of these keys, so a removed line is absent too.
MYSQL_HOST=mysql
MYSQL_PORT=3306
# each major's example holds its schema in a database of its own, all three in the one development mysql:
# the bunorm/migrate command family builds its migrator on bun's default bookkeeping tables and bun matches
# an applied migration by NAME, so a shared database would give the three sets one bun_migrations and the
# first to land would answer for the others. The databases are created by .dev/docker/mysql/init.sql on a
# fresh volume and by the e2e harness on one that already exists.
MYSQL_DATABASE=melody_example_v3
MYSQL_USER=melody
MYSQL_PASSWORD=melody
# MYSQL_INSECURE=true dials without TLS because the development mysql speaks plain TCP; leave it empty
# against a server with a certificate and the provider verifies the handshake.
MYSQL_INSECURE=true

# the reading archive keeps its record on a connection of its own: the catalogue lives on mysql above and
# the archive of catalogue readings on postgres below — two live databases in one process, each with its
# own function and its own empty-means-unwired switch, so all four combinations boot. The database is this
# major's own: bun matches an applied migration by NAME and its bookkeeping is per database, so a set
# sharing a database with another major's would be answered for by whichever landed first.
# PGSQL_INSECURE=true dials without TLS because the development postgres speaks plain TCP; leave it empty
# against a server with a certificate and the provider verifies the handshake.
PGSQL_HOST=postgres
PGSQL_PORT=5432
PGSQL_DATABASE=melody_example_v3
PGSQL_USER=melody
PGSQL_PASSWORD=melody
PGSQL_INSECURE=true
REDIS_ADDRESS=redis:6379
AMQP_DSN=amqp://guest:guest@rabbitmq:5672/
S3_ENDPOINT=localstack:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=eu-central-1
S3_BUCKET=melody-example
SMTP_ADDRESS=mailpit:1025
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
