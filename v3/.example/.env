MELODY_DEFAULT_MODE=http
MELODY_ENV=dev
MELODY_HTTP_ADDRESS=:8080
MELODY_CLI_NAME=melody-example
MELODY_CLI_DESCRIPTION='melody example application'
MELODY_LOG_PATH=%kernel.logs_dir%/%kernel.environment%.log
MELODY_LOG_LEVEL=debug
MELODY_DEFAULT_LOCALE=en
MELODY_PUBLIC_DIR=public
MELODY_STATIC_INDEX_FILE=index.html
MELODY_STATIC_ENABLE_CACHE=false
MELODY_STATIC_CACHE_MAX_AGE=0

APP_MAX_ITEMS_PER_PAGE=25
APP_CATALOG_TITLE=Melody Example Catalog

APP_CRON_USER=www-data
APP_CRON_HEARTBEAT_AUTO_ENABLED=true
APP_CRON_PRODUCT_USER=catalog

APP_CRON_IMAGE=registry.example.com/melody-example:latest
APP_CRON_NAMESPACE=melody-example
APP_CRON_RESTART_POLICY=OnFailure

# live-integration endpoints for the example's demos (database/redis/amqp/s3/smtp).
# these default to the docker-compose service names so the demos run live in dev; an
# already-set process/host environment variable overrides any value here. defined in
# the project .env (not the docker container) so `go test` never inherits them and the
# env-gated integration tests skip cleanly instead of dialing services the validation
# run does not start.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=melody_example
MYSQL_USER=melody
MYSQL_PASSWORD=melody
REDIS_ADDRESS=redis:6379
AMQP_DSN=amqp://guest:guest@rabbitmq:5672/
S3_ENDPOINT=localstack:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=eu-central-1
S3_BUCKET=melody-example
SMTP_ADDRESS=mailpit:1025
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
